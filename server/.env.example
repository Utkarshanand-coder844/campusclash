PORT=5000
NODE_ENV=development
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require
JWT_SECRET=generate-a-long-random-secret
ADMIN_SIGNUP_CODE=1234
FRONTEND_ORIGIN=http://localhost:3000
FRONTEND_URL=http://localhost:3000
# Required in production for password-reset email delivery.
RESEND_API_KEY=re_xxxxxxxxx
PASSWORD_RESET_EMAIL_FROM=CampusClash <no-reply@example.edu>
# Set TRUST_PROXY=true when deployed behind one reverse proxy so rate limits
# use the visitor IP rather than the proxy IP.
TRUST_PROXY=false
